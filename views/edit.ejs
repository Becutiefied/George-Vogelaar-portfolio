<%- include("partials/header.ejs") %>

<h1>Edit post</h1>

<section class="card">
  <form action="/posts/<%= post.id %>/edit" method="POST">
    <input type="text" name="title" value="<%= post.title %>" aria-label="Title" required>
    <textarea name="content" rows="5" aria-label="Post content" required><%= post.content %></textarea>
    <div class="actions">
      <button type="submit">Save</button>
      <a class="button secondary" href="/">Cancel</a>
    </div>
  </form>
</section>

<%- include("partials/footer.ejs") %>
